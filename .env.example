APP_ENV=development
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=INFO

PULN_BASE_URL=https://puln.seatin.id
# Historical sample date. Set the real session date before running.
PULN_SESSION_DATE=2026-10-31
# Optional overrides. Precedence: PULN_SESSION_URL > PULN_SESSION_SLUG > PULN_SESSION_DATE.
PULN_SESSION_SLUG=
PULN_SESSION_URL=
# Conservative polling. The interval cannot be set below 5 seconds.
PULN_POLL_INTERVAL_SECONDS=10
PULN_MAX_POLL_INTERVAL_SECONDS=60
PULN_REQUEST_TIMEOUT_SECONDS=10

DATABASE_URL=sqlite:///./data/puln_assistant.db

# Comma-separated PULN product IDs.
TARGET_PRODUCT_IDS=100
MAX_CUSTOMERS=10

# Ring the terminal bell on alerts (target stock, session opening, endpoint down).
NOTIFY_BELL=true

# Never put customer information, cookies, or tokens in this file.
